# Copy this file to .env and fill in your keys:  cp .env.example .env

# Required: Claude (structures the transcript and writes the notes)
ANTHROPIC_API_KEY=

# Required: Parallel (live web research for the differential diagnosis)
PARALLEL_API_KEY=

# Required for sending emails: Composio (Gmail toolkit)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Optional: Soniox real-time speech-to-text (much more accurate than Chrome's built-in engine).
# Leave empty to use Chrome's built-in recognition.
SONIOX_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# PARALLEL_EFFORT=medium   # low (~5-10s) | medium (~15-20s) | high (~30-60s)
